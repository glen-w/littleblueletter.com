---
import Base from '../layouts/Base.astro';
import authorsData from '../data/authors.json';

const signupSheetUrl =
  'https://docs.google.com/spreadsheets/d/1sMP_UmzB7Fb_SaUf3JWwVCtHyxsMyBOVJUVzAclZ2WM/edit?usp=sharing';

const templateUrl =
  'https://docs.google.com/document/d/18y_xQoj1MG0fgexS754-vcF1TN2MfYc2GYY9ep0aMzY/edit';
---

<Base
  title="Authors"
  description="Curate a Little Blue Letter."
  path="/write/"
>
  <div class="wrap">
    <article class="card write">
      <h1>Authors</h1>
      <p>Fancy writing an edition?</p>
      <ul>
        <li>
          <a href={signupSheetUrl} target="_blank" rel="noopener noreferrer">Sign-up sheet</a>
        </li>
        <li>
          <a href="/write/instructions/">Instructions / style guide</a>
        </li>
        <li>
          <a href={templateUrl} target="_blank" rel="noopener noreferrer">Template</a>
        </li>
      </ul>
      <ul class="author-wall">
        {authorsData.faces.map((face) => (
          <li>
            <img
              src={face.src}
              alt={face.name ? `${face.name}, Little Blue Letter author` : ''}
              title={face.name ?? undefined}
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              style={`object-position: ${face.position}`}
            />
          </li>
        ))}
      </ul>
    </article>
  </div>
</Base>
