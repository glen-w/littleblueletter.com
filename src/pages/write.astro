---
import Base from '../layouts/Base.astro';

const mailto =
  'mailto:glen.w.wright@gmail.com?subject=' +
  encodeURIComponent('Little Blue Letter — author signup');
---

<Base
  title="Write"
  description="Curate a Little Blue Letter."
  path="/write/"
>
  <div class="wrap">
    <article class="card write">
      <h1>Write</h1>
      <p>
        Letters were curated by young ocean leaders: a quote, a lead, a gif, and a note from the
        week.
      </p>
      <p>
        Want to guest-curate when the list reopens?
        <a href={mailto}>Email with subject “author signup”</a>.
      </p>
    </article>
  </div>
</Base>
