---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const letters = (await getCollection('letters')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const LOGO_MARKERS = [
  '734e28c8-c57b-4330-8dce-b8b42daa5e2b',
  '81bb84db-2a04-4dc4-a6ba-fcc0ee829997',
  '7f376862-3fa1-48ae-abee-928ccdec1bf9',
  '/logo.png',
];

function thumbFromBody(body: string | undefined): string {
  if (!body) return '/logo.png';
  const re = /src=["']([^"']+)["']/gi;
  let match: RegExpExecArray | null;
  while ((match = re.exec(body))) {
    const src = match[1];
    if (!LOGO_MARKERS.some((marker) => src.includes(marker))) {
      return src;
    }
  }
  return '/logo.png';
}

function sent(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Base
  title="Archive"
  description="Every Little Blue Letter, from October 2017 to March 2023."
  path="/archive/"
>
  <div class="wrap">
    <article class="card archive">
      <h1>Archive</h1>
      <p>{letters.length} letters, October 2017 to March 2023.</p>
      <ol class="archive-list">
        {
          letters.map((letter) => (
            <li>
              <div class="meta">
                <a href={`/archive/${letter.data.originalSlug}/`}>{letter.data.title}</a>
                <time datetime={letter.data.date.toISOString().slice(0, 10)}>
                  {sent(letter.data.date)}
                </time>
              </div>
              <img
                class="thumb"
                src={thumbFromBody(letter.body)}
                alt=""
                width="72"
                height="72"
                loading="lazy"
              />
            </li>
          ))
        }
      </ol>
    </article>
  </div>
</Base>
