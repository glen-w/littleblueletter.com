---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const letters = (await getCollection('letters')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(letters, { pageSize: 10 });
}

const { page } = Astro.props;
const pageHref = (n: number) => (n === 1 ? '/archive/' : `/archive/${n}/`);
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);

const LOGO_MARKERS = [
  '734e28c8-c57b-4330-8dce-b8b42daa5e2b',
  '81bb84db-2a04-4dc4-a6ba-fcc0ee829997',
  '7f376862-3fa1-48ae-abee-928ccdec1bf9',
  '/logo.png',
];

function thumbFromBody(body: string | undefined): string {
  if (!body) return '/logo.png';
  const re = /src=["']([^"']+)["']/gi;
  let match: RegExpExecArray | null;
  while ((match = re.exec(body))) {
    const src = match[1];
    if (!LOGO_MARKERS.some((marker) => src.includes(marker))) {
      return src;
    }
  }
  return '/logo.png';
}

function sent(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Base
  title="Archive"
  description="Every Little Blue Letter, from October 2017 to March 2023."
  path="/archive/"
>
  <div class="wrap">
    <article class="card archive">
      <h1>Archive</h1>
      <ol class="archive-list" start={page.start + 1}>
        {
          page.data.map((letter) => (
            <li>
              <div class="meta">
                <a href={`/archive/${letter.data.originalSlug}/`}>{letter.data.title}</a>
                <time datetime={letter.data.date.toISOString().slice(0, 10)}>
                  {sent(letter.data.date)}
                </time>
              </div>
              <img
                class="thumb"
                src={thumbFromBody(letter.body)}
                alt=""
                width="72"
                height="72"
                loading="lazy"
              />
            </li>
          ))
        }
      </ol>
      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="Pagination">
            {page.url.prev && <a href={page.url.prev}>← Previous</a>}
            {pageNumbers.map((n) =>
              n === page.currentPage ? (
                <span class="current" aria-current="page">{n}</span>
              ) : (
                <a href={pageHref(n)}>{n}</a>
              ),
            )}
            {page.url.next && <a href={page.url.next}>Next →</a>}
          </nav>
        )
      }
    </article>
  </div>

<style>
  .pagination {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--lbl-field);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pagination a,
  .pagination .current {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--lbl-field);
    border-radius: 3px;
    text-decoration: none;
  }

  .pagination .current {
    background: var(--lbl-button);
    border-color: var(--lbl-button);
    color: var(--lbl-paper);
  }
</style>
