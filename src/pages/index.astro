---
import Base from '../layouts/Base.astro';

const subscribeUrl = 'https://lists.littleblueletter.com/subscription/form';
---

<Base
  title="Little Blue Letter"
  description="A splash of uplifting ocean stuff, lovingly curated by young ocean leaders and shipped straight to your inbox every Friday."
  path="/"
>
  <div class="wrap">
    <div class="card home">
      <p class="tagline">
        A splash of uplifting ocean stuff, lovingly curated by young ocean leaders &amp; shipped
        straight to your inbox every Friday.
      </p>
      <p class="subscribe-cta">
        <a
          class="subscribe-button"
          href={subscribeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Subscribe
        </a>
      </p>
      <p class="quiet subscribe-hint">Opens in a new tab. Close it when you&apos;re done.</p>
    </div>
  </div>
</Base>
