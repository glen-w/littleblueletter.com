---
import Base from '../layouts/Base.astro';
---

<Base
  title="Little Blue Letter"
  description="A splash of uplifting ocean stuff, lovingly curated by young ocean leaders and shipped straight to your inbox every Friday."
  path="/"
>
  <div class="wrap">
    <div class="card home">
      <img class="logo" src="/logo.png" alt="Little Blue Letter" />
      <h1 class="title">Little Blue Letter</h1>
      <p class="tagline">
        A splash of uplifting ocean stuff, lovingly curated by young ocean leaders &amp; shipped
        straight to your inbox every Friday.
      </p>
      <p class="quiet">The mailing list is not open yet.</p>
      <p class="footer-links">
        <a href="https://twitter.com/littlebluelette">Twitter</a>
        <span class="sep" aria-hidden="true">|</span>
        <a href="/archive/">Archive</a>
        <span class="sep" aria-hidden="true">|</span>
        <a href="/write/">Write</a>
        <span class="sep" aria-hidden="true">|</span>
        <a href="/contact/">Contact</a>
      </p>
    </div>
  </div>
</Base>
